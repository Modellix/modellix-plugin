{
  "version": 1,
  "hooks": {
    "afterShellExecution": [
      {
        "command": "python3 .cursor/hooks/after_git_push.py",
        "matcher": "git\\s+push",
        "timeout": 120
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/on_stop_listings.py",
        "loop_limit": 1,
        "timeout": 15
      }
    ]
  }
}
