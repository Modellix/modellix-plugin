{
  "name": "@modellix/modellix-plugin",
  "version": "3.9.0",
  "description": "Unified API/CLI for AI image, video, and audio workflows via Modellix",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node ./scripts/run_python_tests.mjs"
  },
  "keywords": [
    "openclaw",
    "clawhub",
    "pi-package",
    "pi",
    "modellix",
    "cursor-plugin",
    "image-generation",
    "video-generation",
    "audio-generation",
    "speech-to-text",
    "ai"
  ],
  "homepage": "https://docs.modellix.ai/ways-to-use/plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modellix/modellix-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Modellix/modellix-plugin/issues"
  },
  "author": {
    "name": "Modellix",
    "email": "support@modellix.ai",
    "url": "https://modellix.ai"
  },
  "files": [
    "plugin.json",
    "mcp.json",
    "openclaw.plugin.json",
    ".mcp.json",
    "commands/**",
    "rules/**",
    "hooks/**",
    "scripts/**",
    "!scripts/**/__pycache__/**",
    "!scripts/**/*.pyc",
    "skills/**",
    "!skills/**/__pycache__/**",
    "!skills/**/*.pyc",
    ".opencode/skills/**",
    ".pi/skills/**",
    ".plugin/**",
    ".claude-plugin/**",
    ".cursor-plugin/**",
    ".codex-plugin/**",
    ".agents/plugins/**",
    "assets/**",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.3.22",
      "minGatewayVersion": "2026.3.22"
    },
    "build": {
      "openclawVersion": "2026.3.22"
    },
    "install": {
      "clawhubSpec": "@modellix/modellix-plugin",
      "defaultChoice": "clawhub"
    }
  }
}
