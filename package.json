{
  "name": "@modellix/modellix-plugin",
  "version": "3.2.0",
  "description": "Unified API/CLI for AI image and video generation via Modellix",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "clawhub",
    "modellix",
    "image-generation",
    "video-generation",
    "ai"
  ],
  "homepage": "https://docs.modellix.ai/ways-to-use/skill.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modellix/modellix-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Modellix/modellix-plugin/issues"
  },
  "author": {
    "name": "Modellix",
    "url": "https://modellix.ai"
  },
  "files": [
    "openclaw.plugin.json",
    "skills/**",
    ".opencode/skills/**",
    ".plugin/**",
    ".claude-plugin/**",
    ".cursor-plugin/**",
    ".codex-plugin/**",
    ".agents/plugins/**",
    "assets/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "openclaw": {
    "compat": {
      "pluginApi": ">=2026.3.22",
      "minGatewayVersion": "2026.3.22"
    },
    "build": {
      "openclawVersion": "2026.3.22"
    },
    "install": {
      "clawhubSpec": "@modellix/modellix-plugin",
      "defaultChoice": "clawhub"
    }
  }
}
