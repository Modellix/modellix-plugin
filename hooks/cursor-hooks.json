{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/run_python_hook.mjs\" modellix_run_guard",
        "matcher": "modellix-cli",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/run_python_hook.mjs\" modellix_task_watch",
        "matcher": "modellix-cli",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/run_python_hook.mjs\" modellix_stop_reminder",
        "loop_limit": 1,
        "timeout": 10
      }
    ]
  }
}
