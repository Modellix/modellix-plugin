{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/modellix_run_guard.py\"",
        "matcher": "modellix-cli",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/modellix_task_watch.py\"",
        "matcher": "modellix-cli",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/modellix_stop_reminder.py\"",
        "loop_limit": 1,
        "timeout": 10
      }
    ]
  }
}
